rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Safe seed for Story 1.1: deny everything until per-collection Security
    // Rules are implemented in later stories (AD-8: workspace boundary =
    // security boundary; never `allow read, write: if true`).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
